# Copier ce fichier en .env et adapter les valeurs
DB_USER=eclair
DB_PASSWORD=eclair
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=eclair_commercial

API_PREFIX=/api/v1
ORIGINS_CORS=http://localhost:4200
HOST_IP=127.0.0.1
APP_ENV=dev
DEBUG=true

# Générer une clé forte : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=a-remplacer
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_REFRESH_TOKEN_EXPIRE_DAYS=1

# Nombre de workers Uvicorn dans le conteneur
WEB_CONCURRENCY=2
